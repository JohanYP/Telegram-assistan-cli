# Saca api_id y api_hash en https://my.telegram.org -> "API development tools"
API_ID=12345
API_HASH=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Username del bot con el que quieres hablar (con o sin @)
BOT_USERNAME=@mi_bot

# Activa o desactiva el wake word al arrancar. También se cambia en runtime con Ctrl+W.
WAKE_ENABLED=true

# Backend de wake word:
#   openwakeword -> rápido y preciso, pero solo frases pre-entrenadas
#                   (alexa, hey_jarvis, hey_mycroft, hey_rhasspy).
#   vosk         -> reconoce CUALQUIER frase (ej. "hey il") sin entrenar nada,
#                   descarga un modelo de ~40 MB la primera vez.
WAKE_BACKEND=openwakeword

# Si WAKE_BACKEND=openwakeword, usa una de las palabras pre-entrenadas.
# Si WAKE_BACKEND=vosk, pon la frase tal cual quieres decirla, ej. "hey il".
WAKE_WORD=hey_jarvis

# Umbral solo para openwakeword (0..1; baja si no se activa, sube si hay falsos positivos).
WAKE_THRESHOLD=0.5

# Idioma del modelo Vosk (solo si WAKE_BACKEND=vosk): "es" o "en".
VOSK_LANG=es

# 0..3, agresividad del VAD para detectar fin de habla. Más alto = más estricto.
VAD_AGGRESSIVENESS=2
SILENCE_TIMEOUT_MS=1500
MAX_RECORDING_S=15

# Opcional: dispositivo de entrada de audio (índice de sounddevice). Vacío = default.
INPUT_DEVICE=
